<?xml version="1.0" encoding="utf-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="MailApp">
  <Id>01299fcb-58f9-4cbb-9c90-967ebf365c2a</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Sponty CSWI</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Sponty CSWI"/>
  <Description DefaultValue="Community Service Requests, approvals and documents"/>
  <IconUrl DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-128.png"/>
  <SupportUrl DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/"/>
  <AppDomains><AppDomain>https://YOUR-DEPLOYED-ORIGIN.invalid</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.8"/></Sets></Requirements>
  <FormSettings><Form xsi:type="ItemRead"><DesktopSettings>
    <SourceLocation DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/"/>
    <RequestedHeight>450</RequestedHeight>
  </DesktopSettings></Form></FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.8"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
      <FunctionFile resid="FunctionFile.Url"/>
      <ExtensionPoint xsi:type="MessageReadCommandSurface">
        <OfficeTab id="TabDefault"><Group id="cswi.group">
          <Label resid="Group.Label"/>
          <Control xsi:type="Button" id="cswi.button">
            <Label resid="Button.Label"/>
            <Supertip><Title resid="Button.Label"/><Description resid="Button.Tooltip"/></Supertip>
            <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
            <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
          </Control>
        </Group></OfficeTab>
      </ExtensionPoint>
    
      <ExtensionPoint xsi:type="MessageComposeCommandSurface">
        <OfficeTab id="TabDefault"><Group id="cswi.compose.group">
          <Label resid="Group.Label"/>
          <Control xsi:type="Button" id="cswi.compose.button">
            <Label resid="Compose.Button.Label"/>
            <Supertip><Title resid="Compose.Button.Label"/><Description resid="Compose.Button.Tooltip"/></Supertip>
            <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
            <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
          </Control>
        </Group></OfficeTab>
      </ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/"/>
        <bt:Url id="FunctionFile.Url" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Community Service"/>
        <bt:String id="Button.Label" DefaultValue="Sponty CSWI"/>
        <bt:String id="Compose.Button.Label" DefaultValue="Add CSWI Reference"/>
      </bt:ShortStrings>
      <bt:LongStrings><bt:String id="Button.Tooltip" DefaultValue="Open the Community Service request management panel"/>
        <bt:String id="Compose.Button.Tooltip" DefaultValue="Insert a community service request reference into this Outlook draft"/></bt:LongStrings>
    </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements><bt:Sets DefaultMinVersion="1.8"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
      <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
        <FunctionFile resid="FunctionFile.Url"/>
        <ExtensionPoint xsi:type="MessageReadCommandSurface"><OfficeTab id="TabDefault">
          <Group id="cswi.group.pin">
            <Label resid="Group.Label"/>
            <Control xsi:type="Button" id="cswi.button.pin">
              <Label resid="Button.Label"/>
              <Supertip><Title resid="Button.Label"/><Description resid="Button.Tooltip"/></Supertip>
              <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
              <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/><SupportsPinning>true</SupportsPinning></Action>
            </Control>
          </Group>
        </OfficeTab></ExtensionPoint>
      
      <ExtensionPoint xsi:type="MessageComposeCommandSurface">
        <OfficeTab id="TabDefault"><Group id="cswi.compose.group">
          <Label resid="Group.Label"/>
          <Control xsi:type="Button" id="cswi.compose.button">
            <Label resid="Compose.Button.Label"/>
            <Supertip><Title resid="Compose.Button.Label"/><Description resid="Compose.Button.Tooltip"/></Supertip>
            <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
            <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
          </Control>
        </Group></OfficeTab>
      </ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/icons/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/"/>
          <bt:Url id="FunctionFile.Url" DefaultValue="https://YOUR-DEPLOYED-ORIGIN.invalid/"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Community Service"/>
          <bt:String id="Button.Label" DefaultValue="Sponty CSWI"/>
        <bt:String id="Compose.Button.Label" DefaultValue="Add CSWI Reference"/>
        </bt:ShortStrings>
        <bt:LongStrings><bt:String id="Button.Tooltip" DefaultValue="Open the Community Service request management panel"/>
        <bt:String id="Compose.Button.Tooltip" DefaultValue="Insert a community service request reference into this Outlook draft"/></bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
